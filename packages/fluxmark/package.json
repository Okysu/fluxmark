{
  "name": "fluxmark",
  "version": "0.1.0",
  "description": "Zero-backtracking FluxMark compiler with a typed AST, staged plugins and a semantic HTML renderer.",
  "keywords": ["fluxmark", "markup", "parser", "ast", "html", "compiler"],
  "license": "MIT",
  "author": "FluxMark contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okysu/fluxmark.git",
    "directory": "packages/fluxmark"
  },
  "bugs": {
    "url": "https://github.com/Okysu/fluxmark/issues"
  },
  "homepage": "https://okysu.github.io/fluxmark/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/fluxmark.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/generate-styles.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
