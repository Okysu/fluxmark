{
  "name": "fluxmark-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Okysu/fluxmark.git"
  },
  "homepage": "https://okysu.github.io/fluxmark/",
  "bugs": {
    "url": "https://github.com/Okysu/fluxmark/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "build": "pnpm --filter fluxmark build && vitepress build docs",
    "build:docs": "vitepress build docs",
    "test": "pnpm --filter fluxmark test",
    "test:migrate": "pnpm --filter fluxmark build && node --test tools/migrate-markdown.test.mjs",
    "test:coverage": "pnpm --filter fluxmark test:coverage",
    "bench": "pnpm --filter fluxmark build && node --expose-gc benchmarks/run.mjs",
    "bench:update": "pnpm --filter fluxmark build && node --expose-gc benchmarks/run.mjs --write",
    "migrate": "node tools/migrate-markdown.mjs",
    "typecheck": "pnpm --filter fluxmark typecheck && vue-tsc --noEmit -p docs/tsconfig.json",
    "docs:preview": "vitepress preview docs",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "commonmark": "^0.31.2",
    "markdown-it": "^15.0.3",
    "marked": "^18.1.1",
    "snarkdown": "^2.0.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.13"
  }
}
